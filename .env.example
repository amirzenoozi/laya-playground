# The Laya checkpoint folder (rl_agent_config.json, model.safetensors, tokenizer/, encoder/). Nothing is downloaded:
# by default it uses the copy Z-Image already has.
LAYA_MODEL_PATH=../z-image-inference/models/laya

# Seconds Laya stays loaded after the last question; 0 unloads it straight after each request.
LAYA_KEEP_ALIVE=300

# CPU threads Laya uses.
LAYA_THREADS=8

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
