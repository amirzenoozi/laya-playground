# The Laya checkpoint folder; `make setup` (or `make model`) downloads it there when it is missing. A relative path
# starts at the project root. Point it at an existing copy to reuse it, e.g. ../z-image-inference/models/laya.
LAYA_MODEL_PATH=models/laya

# Seconds Laya stays loaded after the last question; 0 unloads it straight after each request.
LAYA_KEEP_ALIVE=300

# CPU threads Laya uses.
LAYA_THREADS=8

# Ollama, for the Chat tab: its address, and how long a chat model stays loaded after the last reply (seconds, or a
# duration such as 30s, 5m or 1h). The playground lists the models Ollama already has; it never pulls one.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=5m

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
